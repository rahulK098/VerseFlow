FROM python:3.12-slim

# Install Python deps into the image (layer-cached; only re-runs when requirements.txt changes)
# Build context is the repo root, so path is relative to that.
COPY apps/api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Source code is bind-mounted at /workspace at runtime (docker-compose.yml).
# working_dir is also set by docker-compose to /workspace/apps/api.
WORKDIR /workspace/apps/api

EXPOSE 8000

# uvicorn --reload watches for .py changes and restarts in-process — no extra tool needed.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
